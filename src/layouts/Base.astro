---
// Grund-Layout: Head (SEO/OG), Kopfleiste, Fußzeile. Keine Tracker, keine externen
// Ressourcen — Fonts kommen aus node_modules und werden von Astro lokal gebündelt.
// Runde 13 (FXR-142): Kopfleiste/Fußzeile jetzt auf Tinte (Referenz `export-web-v2`).
// FXR-164 (Michael 2026-09-05: "Header muss in allen Ansichten gleich sein"): Kopfleiste
// jetzt drei Zonen (Marke/Menü/Aktionen), gemessen an `temp/export-web-v3/FixedR Web
// Home.html` (Runde 15). Ausschließlich hier geändert — keine Sonderfassung je Seite.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { SITE_TITLE, TAGLINE, DESCRIPTION } from '../config';

interface Props {
  title?: string;
  description?: string;
  narrow?: boolean;
  /** Seiten mit eigenen <section>-Bändern setzen das Innen-Wrapping selbst. */
  bare?: boolean;
}
const { title, description = DESCRIPTION, narrow = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_TITLE}` : `${SITE_TITLE} — ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Aktive Seite in der Kopfleiste (Kanvas 2026-09-02): Marke statt Neutral auf dem
// Nav-Ziel, das der aktuellen Seite entspricht. Nur /product, /methodology, /trust
// tragen ein eigenes Nav-Ziel — Home hat keins, deshalb bleibt dort alles neutral.
// FXR-164 (gefunden beim Sichtprüfen): `build.format: 'file'` (astro.config.mjs) liefert
// Astro.url.pathname WÄHREND des Baus mit ".html"-Endung (z. B. "/product.html" statt
// "/product") — der Vergleich unten traf deshalb auf JEDER Seite ins Leere, kein
// aria-current wurde je gesetzt. Erst die Endung abschneiden, dann vergleichen.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (path === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* E-C216 (2026-09-02): kein Produktivdeploy, die Site steht hinter einer
        Login-Wall auf dem Testserver. JEDE Seite bleibt uncrawlbar, solange dieser
        Zustand gilt — dazu public/robots.txt (Disallow: /) und der dist-Wächter
        (tools/guards.mjs --dist), der den Bau bricht, wenn diese Zeile fehlt. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="theme-color" content="#06070a" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="logo" href="/" aria-label="FixedR home">
          {/* Die Aufstellung ist gezeichnet, nicht gesetzt: Bildmarke, Wortmarke und
              Untertitel liegen als Pfade vor, damit sie unabhängig von geladenen
              Schriften sitzen. Deshalb steht die Tagline hier nicht als Text. Auf
              der jetzt dunklen Kopfleiste (Runde 13) braucht es die helle Variante. */}
          <img src="/logo-full-on-dark.svg" alt="FixedR — trade calm. by design." width="140" height="41" />
        </a>
        <nav>
          {/* product §3 Stufe 1: /product und /methodology sind die zwei
              Stockwerke des Angebots (R2), /trust die Vertrauensseite (§6). Reihenfolge
              folgt der Kaufentscheidung: was es tut, wie es bindet, warum man ihm traut. */}
          <a href="/product" aria-current={isActive('/product')}>Product</a>
          <a href="/methodology" aria-current={isActive('/methodology')}>Methodology</a>
          <a href="/trust" aria-current={isActive('/trust')}>Trust</a>
          <a href="/manifesto" aria-current={isActive('/manifesto')}>Manifesto</a>
          <a href="/faq" aria-current={isActive('/faq')}>FAQ</a>
          <a href="/blog" aria-current={isActive('/blog')}>Blog</a>
        </nav>
        <span class="head-actions">
          {/* Sprachwechsel (FXR-164, gemessen an `FixedR Web Home.html`: Höhe 26px,
              Innenrand 0 9px, Rahmenradius außen 6px/innen 4px, Geist Mono 12/600).
              Der Mechanismus bleibt unverändert (data-lang-switch, localStorage, reiner
              UI-Zustand ohne Fließtext-Übersetzung) — nur die Gestalt wird zum
              Segmentschalter statt Textlink ("EN / DE"). Ob echte DE-Übersetzung folgen
              soll, ist weiter eine offene Frage an Michael (Protokoll).
              FXR-164 (Michael 2026-09-05, "die sprachen ... die reihenfolge nicht
              wechseln"): EN steht fest links, DE fest rechts — beide Glieder tragen ihre
              Sprache als eigenes, unveränderliches Element (data-lang-en/-de). Nur die
              Klasse "active" wandert per Skript zwischen ihnen, nie der Text. */}
          <a href="#" class="lang-switch" data-lang-switch aria-label="Switch language">
            <span class="seg active" data-lang-en>EN</span><span class="seg" data-lang-de>DE</span>
          </a>
          <a class="cta" href="/waitlist">Join the waitlist</a>
        </span>
      </div>
    </header>
    <main class={narrow ? 'narrow' : undefined}>
      {bare ? <slot /> : <div class="wrap"><slot /></div>}
    </main>
    <footer class="site ink">
      <div class="inner">
        <div class="footer-cols">
          <div class="brand-col">
            <img src="/logo-full-on-dark.svg" alt="FixedR" width="128" height="38" />
            <p>A trading cockpit for prop-firm accounts. Local-first, Windows, no cloud account.</p>
          </div>
          <nav>
            <div class="group">
              <span class="group-label">Product</span>
              <a href="/product">Product</a>
              <a href="/methodology">Methodology</a>
              <a href="/trust">Trust</a>
            </div>
            <div class="group">
              <span class="group-label">Read</span>
              <a href="/manifesto">Manifesto</a>
              <a href="/faq">FAQ</a>
              <a href="/blog">Blog</a>
            </div>
            <div class="group">
              <span class="group-label">Legal</span>
              <a href="/imprint">Imprint</a>
              <a href="/privacy">Privacy</a>
            </div>
          </nav>
        </div>
        <div class="footer-legal">
          <span class="mono">© FixedR</span>
          <span class="notrack">This site sets no cookies and loads nothing from third parties.</span>
        </div>
      </div>
    </footer>
    <script>
      // Sprachwechsel: reiner UI-Zustand (kein Fließtext-Wechsel, s. Kommentar oben).
      // Persistiert je Gerät über localStorage; jede Seite liest denselben Schlüssel,
      // damit der Zustand über Seitenwechsel hinweg stabil bleibt (G4: "funktioniert
      // auf jeder Seite").
      // FXR-164 (Michael, "die reihenfolge nicht wechseln"): EN und DE bleiben feste
      // Elemente an fester Position — apply() setzt/entfernt nur die Klasse "active",
      // nie den Text. Vorher wanderte per textContent-Tausch die gewählte Sprache
      // immer an die erste (linke) Stelle, wodurch EN/DE die Plätze tauschten.
      const KEY = 'fixedr-lang';
      const link = document.querySelector('[data-lang-switch]');
      const enEl = document.querySelector('[data-lang-en]');
      const deEl = document.querySelector('[data-lang-de]');
      function apply(lang: string) {
        enEl?.classList.toggle('active', lang === 'EN');
        deEl?.classList.toggle('active', lang === 'DE');
        document.documentElement.setAttribute('data-lang', lang.toLowerCase());
      }
      try {
        apply(localStorage.getItem(KEY) === 'DE' ? 'DE' : 'EN');
      } catch {
        apply('EN');
      }
      link?.addEventListener('click', (e) => {
        e.preventDefault();
        const current = deEl?.classList.contains('active') ? 'DE' : 'EN';
        const next = current === 'EN' ? 'DE' : 'EN';
        apply(next);
        try {
          localStorage.setItem(KEY, next);
        } catch {
          /* privater Modus o. Ä. — der Klick bleibt trotzdem sichtbar. */
        }
      });
    </script>
  </body>
</html>
