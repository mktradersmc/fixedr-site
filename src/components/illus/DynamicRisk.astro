---
// Dynamisches R: die Risikogröße folgt einer Regel, die im Kontoprofil steht.
---
<svg viewBox="0 0 200 120" role="img" aria-label="Risk per trade adapts to account state by rule" width="100%">
  <text x="18" y="30" font-family="var(--font-text)" font-size="10" fill="var(--muted)">rule · risk per trade</text>
  {[
    ['in drawdown', '0.25 %', 30],
    ['normal', '0.50 %', 62],
    ['at target', '0.75 %', 94],
  ].map((row, i) => (
    <>
      <rect x="18" y={38 + i * 26} width="164" height="20" rx="5"
            fill={i === 1 ? 'var(--signal-bg)' : 'var(--surface-2)'}
            stroke={i === 1 ? 'var(--signal)' : 'var(--line)'} stroke-width={i === 1 ? 2 : 1} />
      <text x="30" y={52 + i * 26} font-family="var(--font-text)" font-size="10" fill="var(--muted)">{row[0]}</text>
      <text x="170" y={52 + i * 26} text-anchor="end" font-family="var(--font-mono)" font-size="11"
            font-weight={i === 1 ? 700 : 400} fill={i === 1 ? 'var(--signal)' : 'var(--text)'}>{row[1]}</text>
    </>
  ))}
</svg>
