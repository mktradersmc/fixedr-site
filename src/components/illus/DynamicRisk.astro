---
// Dynamisches R: die Risikogröße folgt einer Regel, die im Kontoprofil steht — nicht
// einer Entscheidung im Moment. Die Regel wird BENANNT, nicht angedeutet: eine
// Andeutung ließe offen, wer sie festlegt, und genau das ist der Punkt.
const lagen = [
  { lage: 'in drawdown', wert: '0.25 %' },
  { lage: 'normal', wert: '0.50 %', jetzt: true },
  { lage: 'at target', wert: '0.75 %' },
];
---
<div class="rows" role="img" aria-label="Risk per trade follows a written rule for each account state">
  <span class="row-label">rule · risk per trade</span>
  {lagen.map((l) => (
    <div class={l.jetzt ? 'row now' : 'row'}>
      <span>{l.lage}</span>
      <span class={l.jetzt ? 'now-val' : ''}>{l.wert}</span>
    </div>
  ))}
</div>
