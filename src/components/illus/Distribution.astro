---
// Konten-Verteilung: ein Auftrag, viele Konten — und ohne Konfiguration wird nichts
// geraten (E-C125). Genau deshalb steht die dritte Zeile hier: das unkonfigurierte
// Konto ist kein Randfall, es ist das Versprechen. Ein Bild, in dem alles glatt
// läuft, würde die Zusage nicht zeigen.
//
// Die Firmennamen sind echt (Michael-Entscheid 2026-08-27). Sie sind eine Aussage
// über Anbindbarkeit, keine Partnerschaft.
const konten = [
  { name: 'FTMO 100k', wert: '4.2', aktiv: true },
  { name: 'Apex 150k', wert: '6.1', aktiv: true },
  { name: 'Lucid 50k', wert: 'not configured', aktiv: false },
];
---
<div class="rows">
  <div class="row head"><span>MES · SHORT</span><span>1 R</span></div>
  <div class="rows indent">
    {konten.map((k) => (
      <div class="row">
        <span>{k.name}</span>
        <span class={k.aktiv ? 'on' : 'off'}>{k.wert}</span>
      </div>
    ))}
  </div>
</div>
