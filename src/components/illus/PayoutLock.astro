---
// Auszahlungs-Schutz: Konto erreicht Auszahlungsreife und wird stillgelegt.
---
<svg viewBox="0 0 200 120" role="img" aria-label="Account reaches payout eligibility and is locked from trading" width="100%">
  <rect x="18" y="26" width="164" height="34" rx="8" fill="var(--surface-2)" stroke="var(--line)" stroke-width="2" />
  <text x="32" y="48" font-family="var(--font-text)" font-size="11" font-weight="600" fill="var(--text)">Account C</text>
  <text x="168" y="48" text-anchor="end" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--brand)">+8.4R</text>

  <rect x="18" y="66" width="164" height="38" rx="8" fill="var(--brand-soft)" stroke="var(--brand)" stroke-width="2" />
  <g transform="translate(34 76)">
    <rect x="0" y="7" width="15" height="12" rx="2.5" fill="none" stroke="var(--brand)" stroke-width="2" />
    <path d="M 3.2 7 v -3.4 a 4.3 4.3 0 0 1 8.6 0 V 7" fill="none" stroke="var(--brand)" stroke-width="2" />
  </g>
  <text x="60" y="83" font-family="var(--font-text)" font-size="10.5" font-weight="600" fill="var(--text)">payout eligible</text>
  <text x="60" y="96" font-family="var(--font-text)" font-size="10" fill="var(--muted)">trading paused</text>
</svg>
