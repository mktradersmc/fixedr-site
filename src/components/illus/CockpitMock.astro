---
// Stilisierter Cockpit-Ausschnitt (helle Fassung) — Platzhalter bis echte
// App-Screenshots vorliegen. Bewusst OHNE jeden Geldwert: nur R und Prozent.
---
<svg viewBox="0 0 960 460" role="img" width="100%"
     aria-label="FixedR cockpit: chart with stop level, order ticket in R, account tiles">
  <style>
    .lbl { font-family: var(--font-text); font-size: 11px; fill: var(--muted); }
    .lbl-b { font-family: var(--font-text); font-size: 12px; font-weight: 600; fill: var(--text); }
    .num { font-family: var(--font-mono); font-size: 12px; fill: var(--text); }
    .num-s { font-family: var(--font-mono); font-size: 11px; fill: var(--muted); }
    .r-pos { font-family: var(--font-mono); font-size: 13px; font-weight: 700; fill: var(--signal); }
    .panel { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
    .soft { fill: var(--bg-alt); stroke: var(--line); stroke-width: 1; }
  </style>

  <!-- Seitenleiste -->
  <rect x="0" y="0" width="52" height="460" rx="8" class="soft" />
  {[26, 62, 98, 134, 170].map((y, i) => (
    <rect x="14" y={y} width="24" height="18" rx="5"
          fill={i === 1 ? 'var(--signal-bright)' : 'var(--line)'} />
  ))}

  <!-- Chart -->
  <rect x="64" y="0" width="580" height="290" rx="10" class="panel" />
  <text x="80" y="24" class="lbl-b">MNQ · 5m</text>
  <text x="150" y="24" class="num-s">session: New York</text>

  <!-- Kerzen (bewusst neutral gefärbt, kein Grün/Rot) -->
  {[
    [96, 150, 46], [124, 128, 58], [152, 142, 40], [180, 116, 62], [208, 104, 44],
    [236, 130, 52], [264, 96, 66], [292, 118, 38], [320, 88, 58], [348, 110, 46],
    [376, 78, 62], [404, 104, 40], [432, 92, 54], [460, 70, 68], [488, 96, 42],
    [516, 84, 50], [544, 66, 60], [572, 90, 38], [600, 74, 52],
  ].map(([x, y, h]) => (
    <>
      <line x1={x + 6} y1={y - 10} x2={x + 6} y2={y + h + 10} stroke="var(--line)" stroke-width="1.5" />
      <rect x={x} y={y} width="12" height={h} rx="2" fill="var(--surface-2)" stroke="#B9C3D2" stroke-width="1.2" />
    </>
  ))}

  <!-- Einstieg + Stop -->
  <line x1="80" y1="112" x2="628" y2="112" stroke="var(--signal-bright)" stroke-width="2" stroke-dasharray="6 5" />
  <text x="634" y="109" text-anchor="end" class="num-s" style="fill:var(--signal)">entry</text>
  <line x1="80" y1="212" x2="628" y2="212" stroke="#101623" stroke-width="2" stroke-dasharray="6 5" opacity=".55" />
  <text x="634" y="226" text-anchor="end" class="num-s">stop · 1R</text>
  <rect x="80" y="112" width="548" height="100" fill="var(--signal-bright)" opacity=".07" />

  <!-- Order-Ticket -->
  <rect x="664" y="0" width="296" height="290" rx="10" class="panel" />
  <text x="684" y="26" class="lbl-b">Order</text>

  <text x="684" y="56" class="lbl">Risk per trade</text>
  <rect x="684" y="64" width="120" height="28" rx="6" class="soft" />
  <text x="696" y="83" class="num">0.50 %</text>
  <text x="816" y="83" class="num-s">= 1R</text>

  <text x="684" y="118" class="lbl">Stop distance</text>
  <rect x="684" y="126" width="120" height="28" rx="6" class="soft" />
  <text x="696" y="145" class="num">32 ticks</text>

  <text x="684" y="180" class="lbl">Size (computed)</text>
  <rect x="684" y="188" width="256" height="34" rx="6" fill="var(--signal-bg)" stroke="#F0DCB4" />
  <text x="696" y="210" class="num" style="font-weight:700">3 contracts</text>
  <text x="930" y="210" text-anchor="end" class="num-s">effective 0.47 %</text>

  <rect x="684" y="238" width="256" height="34" rx="7" fill="var(--signal-bright)" />
  <text x="812" y="260" text-anchor="middle" class="lbl-b" style="fill:#241B08">Place across 3 accounts</text>

  <!-- Konten -->
  <rect x="64" y="304" width="580" height="156" rx="10" class="panel" />
  <text x="80" y="328" class="lbl-b">Accounts</text>
  {[
    ['Account A', '+2.4R', 'day  +0.8R', '62 %'],
    ['Account B', '+1.1R', 'day  −1.0R', '48 %'],
    ['Account C', '+3.6R', 'day  +1.5R', '71 %'],
  ].map((row, i) => (
    <>
      <rect x={80 + i * 188} y="342" width="172" height="98" rx="8" class="soft" />
      <text x={96 + i * 188} y="364" class="lbl-b">{row[0]}</text>
      <text x={96 + i * 188} y="392" class="r-pos">{row[1]}</text>
      <text x={96 + i * 188} y="412" class="num-s">{row[2]}</text>
      <text x={96 + i * 188} y="430" class="num-s">to target {row[3]}</text>
      <rect x={96 + i * 188} y="434" width="140" height="4" rx="2" fill="var(--line)" />
      <rect x={96 + i * 188} y="434" width={[87, 67, 99][i]} height="4" rx="2" fill="var(--signal-bright)" />
    </>
  ))}

  <!-- Risikobudget -->
  <rect x="664" y="304" width="296" height="156" rx="10" class="panel" />
  <text x="684" y="328" class="lbl-b">Daily risk budget</text>
  <text x="684" y="360" class="r-pos" style="font-size:26px">4.0R</text>
  <text x="750" y="360" class="num-s">left of 5.0R</text>
  <rect x="684" y="376" width="256" height="8" rx="4" fill="var(--line)" />
  <rect x="684" y="376" width="205" height="8" rx="4" fill="var(--signal-bright)" />
  <text x="684" y="408" class="lbl">Drawdown headroom</text>
  <text x="684" y="432" class="num" style="font-weight:700">3.2 %</text>
  <text x="736" y="432" class="num-s">of 6.0 % limit</text>
</svg>
