---
// Künstlicher Horizont — Metapher für Tilt: das Instrument sagt die Wahrheit, das Gefühl nicht.
---
<svg viewBox="0 0 200 120" role="img" aria-label="Artificial horizon instrument" width="100%">
  <defs>
    <clipPath id="horizonClip"><circle cx="100" cy="60" r="46" /></clipPath>
  </defs>
  <circle cx="100" cy="60" r="50" fill="var(--surface-2)" stroke="var(--line)" stroke-width="3" />
  <g clip-path="url(#horizonClip)">
    <rect x="40" y="10" width="120" height="100" fill="var(--surface)" />
    <rect x="30" y="66" width="140" height="60" fill="var(--signal-bg)" transform="rotate(-8 100 60)" />
    <line x1="40" y1="66" x2="160" y2="66" stroke="var(--signal)" stroke-width="2.5" transform="rotate(-8 100 60)" />
    <line x1="80" y1="46" x2="120" y2="46" stroke="var(--muted)" stroke-width="1" />
    <line x1="86" y1="56" x2="114" y2="56" stroke="var(--muted)" stroke-width="1" />
  </g>
  <path d="M 88 60 L 96 60 L 100 66 L 104 60 L 112 60" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round" />
  <line x1="100" y1="14" x2="100" y2="22" stroke="var(--muted)" stroke-width="2" />
</svg>
