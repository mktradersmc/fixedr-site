---
// Der Monat in R. Die Zahlen sind Beispielwerte und dürfen es sein — sie zeigen die
// FORM des Rückblicks, nicht ein Ergebnis. Deshalb liegen Verlusttage mitten im
// Monat: ein Raster, in dem alles grün wäre, wäre eine Renditebehauptung.
//
// Zwei Stufen statt einer Farbrampe (Entwurf): eine stufenlose Mischung hat nur an
// ihren Enden Kontrast. Verluste bleiben neutral — auf dieser Seite gibt es kein Rot
// und kein Grün als Wertung.
const werte = [
  0, 1.2, -0.4, 2.1, 0, 0, 0,
  0.8, 1.9, -1, 0.5, 3.2, 0, 0,
  -0.6, 2.4, 1.1, 0, 0.9, 1.4, 0,
  0, -0.3, 1.8, 2.6, 0.7, -1.2, 0,
];
const tage = werte.map((w) => {
  if (w === 0) return { klasse: 'd', text: '·' };
  if (w > 0) return { klasse: `d win${w >= 1.8 ? ' strong' : ''}`, text: `+${w.toFixed(1)}` };
  return { klasse: 'd loss', text: `−${Math.abs(w).toFixed(1)}` };
});
const summe = werte.reduce((a, b) => a + b, 0);
---
<div class="cal" role="img" aria-label="A month of daily results measured in R">
  <div class="days">
    {tage.map((t) => <span class={t.klasse}>{t.text}</span>)}
  </div>
  <div class="foot">
    <span class="m">May 2026</span>
    <span class="sum">+{summe.toFixed(1)} R</span>
  </div>
</div>
