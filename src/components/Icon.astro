---
// Strichsymbole für Banner-Lanes, Banner-Punkte, Nabe-Kacheln und Feature-Kopfbänder.
//
// ⚠️ ERZEUGT aus dem Kanvas-Entwurf `temp/export-web-v5` (FXR-239, 2026-09-11), Objekt
// `P` der Quelldatei — maschinell übernommen, nicht abgezeichnet. Alle Pfade sind auf
// 24×24 gezeichnet, ohne Füllung; die Strichstärke setzt der Aufrufer.
//
// Ein fehlender Name wirft beim Bau, statt still ein leeres <svg> zu rendern — gleiche
// Regel wie beim ReifegradChip: ein zitierter Name, den es nicht gibt, bricht den Bau.
interface Props {
  name: string;
  size?: number;
  /** Strichstärke: 1.6 für Lane und Kopfband, 1.5 für die kleinen Punkte (v5). */
  stroke?: number;
  /** Nur setzen, wenn das Symbol allein steht — neben Text bleibt es dekorativ. */
  label?: string;
}
const { name, size = 16, stroke = 1.6, label } = Astro.props;

const PATHS: Record<string, string> = {
  pen: "M4 20h4l11-11a2.4 2.4 0 0 0-3.4-3.4L4.5 16.6V20zM14.5 7l2.5 2.5",
  grid: "M4 4h7v6H4zM13 4h7v10h-7zM4 12h7v8H4zM13 16h7v4h-7z",
  bell: "M6.5 10a5.5 5.5 0 0 1 11 0c0 4 1.5 5.5 1.5 5.5H5S6.5 14 6.5 10zM10 19a2.2 2.2 0 0 0 4 0",
  command: "M4 6h16v12H4zM7 10h.01M11 10h.01M15 10h.01M8 14h8",
  replay: "M3.5 12a8.5 8.5 0 1 0 2.6-6.1M3.5 4.5V10h5.5M11 9.5l4 2.5-4 2.5z",
  resume: "M5 4h4v16H5zM11 4l9 8-9 8z",
  idea: "M12 3v2M5.6 5.6l1.4 1.4M3 12h2M19 12h2M17 7l1.4-1.4M9 18h6M10 21h4M8.5 14.5a4.5 4.5 0 1 1 7 0c-.8.9-1 1.6-1 2.5h-5c0-.9-.2-1.6-1-2.5z",
  sigma: "M17 5H7l5.5 7L7 19h10M17 5v2M17 17v2",
  layers: "M12 3.5 3.5 8l8.5 4.5L20.5 8 12 3.5zM3.5 13l8.5 4.5 8.5-4.5",
  archive: "M3.5 5h17v4h-17zM5 9v10h14V9M10 13h4",
  pulse: "M3 12h4l2.5-6 3 12 2.5-6h6",
  shield: "M12 3.5 5 6.5v5c0 4.2 3 7.6 7 9 4-1.4 7-4.8 7-9v-5zM9 12l2 2 4-4",
  compass: "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM15 9l-2 5-4 1 2-5z",
  path: "M3 17c3.5 0 4-8 7.5-8s4 8 7.5 8M16 14l3 3-3 3",
  book: "M5 4.5h6.5V20H5zM12.5 4.5H19V20h-6.5zM15.5 4.5v5l1.5-1.2 1.5 1.2v-5",
  ladder: "M7 3v18M17 3v18M7 7h10M7 12h10M7 17h10",
  statement: "M6 3.5h9l4 4V20.5H6zM15 3.5v4h4M9 12h6M9 16h4",
  chart: "M4 20V9M9.5 20V4M15 20v-7M20.5 20V11M3 20h18",
  clock: "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM12 8v4.5l3 2",
};

if (!Object.hasOwn(PATHS, name)) {
  throw new Error(
    `Icon.astro: Symbol "${name}" gibt es nicht. Vorhanden: ${Object.keys(PATHS).join(", ")}`,
  );
}
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
><path d={PATHS[name]}></path></svg>
