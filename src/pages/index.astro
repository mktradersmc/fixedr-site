<script>
  // ── Abschnitt 6: welche Lage die Bühne zeigt ─────────────────────────────
  // Der Entwurf bestimmt den aktiven Schritt per IntersectionObserver mit
  // `rootMargin: -40% 0 -50%` — ein schmales Band in der Bildschirmmitte. Nur was
  // DORT steht, gilt als aktiv; dadurch wechselt die Bühne, wenn der Schritt gelesen
  // wird, und nicht schon beim Hereinscrollen.
  const schritte = document.querySelectorAll<HTMLElement>('[data-schritt]');
  const lagen = document.querySelectorAll<HTMLElement>('[data-lage]');
  const punkte = document.querySelectorAll<HTMLElement>('[data-punkt]');
  const titel = document.querySelector<HTMLElement>('[data-buehne-titel]');
  const TITEL = ['One ticket · three accounts', 'Linked symbols', 'Payout protection', 'Your month in R'];

  if (schritte.length && lagen.length) {
    const zeige = (n: number) => {
      schritte.forEach((el, i) => el.toggleAttribute('data-aktiv', i === n));
      // Eine schon gezeigte Lage weicht nach OBEN, eine kommende steht unten —
      // deshalb gibt es neben „an" auch „vor". Ohne das läge der Wechsel in beide
      // Richtungen gleich und die Bewegung verlöre ihre Richtung.
      lagen.forEach((el, i) => {
        el.toggleAttribute('data-an', i === n);
        el.toggleAttribute('data-vor', i < n);
      });
      punkte.forEach((el, i) => el.toggleAttribute('data-an', i === n));
      if (titel) titel.textContent = TITEL[n] ?? TITEL[0];
    };
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) zeige(Number((e.target as HTMLElement).dataset.schritt)); }),
      { rootMargin: '-40% 0px -50% 0px' },
    );
    schritte.forEach((el) => io.observe(el));
  }

  // ── Film-Schleier: Zeigerposition über der Bildkarte ──────────────────────
  // BEFUND FXR-164 (Michael 2026-09-06): Chrome rechnet `:hover` während des
  // Bildlaufs nicht neu — „beim reinscrollen passiert das nicht". Deshalb neben
  // `:hover` eine Klasse, die die Position bei Bewegung UND beim Scrollen prüft.
  const stage = document.querySelector<HTMLElement>('.home-hero .stage');
  if (stage) {
    let px = -1;
    let py = -1;
    const pruefe = () => {
      if (px < 0) return;
      const b = stage.getBoundingClientRect();
      stage.classList.toggle('is-hover', px >= b.left && px <= b.right && py >= b.top && py <= b.bottom);
    };
    window.addEventListener('mousemove', (e) => { px = e.clientX; py = e.clientY; pruefe(); }, { passive: true });
    window.addEventListener('scroll', pruefe, { passive: true });
    window.addEventListener('resize', pruefe, { passive: true });
    document.addEventListener('mouseleave', () => { px = -1; py = -1; stage.classList.remove('is-hover'); });
  }
</script>
