        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Pakete ═══ -->
  <section class="preise" id="pricing">
    <div class="inner">
      <div class="kopf" data-reveal>
        <span class="eyebrow">Pricing</span>
        <h2>Three tiers. One set of rules.</h2>
        <span class="vorschlag">PRICES ARE A PROPOSAL</span>
      </div>
      <div class="karten" data-reveal>
        {pakete.map((p) => (
          <div class:list={['karte', p.hervor && 'hervor']}>
            <span class="zeile">
              <span class="name">{p.name}</span>
              {p.hervor && <span class="marke">MOST TRADERS</span>}
            </span>
            <span class="preis"><b>{p.preis}</b><span>/ month</span></span>
            <span class="satz">{p.satz}</span>
            <ul>{p.punkte.map((x) => <li><span class="hak">✓</span>{x}</li>)}</ul>
            <a class="knopf" href="/waitlist">{p.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ These und Founders: eine dunkle Fläche ═══ -->
  <section class="schluss">
    <span class="raster" aria-hidden="true"></span>
    <div class="inner">
      <div class="these" data-reveal>
        <div class="spalte">
          <span class="eyebrow">What's on the screen</span>
          <h2>There's no money in this account. Only a number and a scale.</h2>
        </div>
        <div class="spalte">
          <p>
            The balance of a funded account is notional — it isn't your money, and often not
            literal capital at all. What's real is your distance to the drawdown limit and to the
            target, both defined in percent. A currency display suggests a concreteness that
            doesn't exist. So we removed it.
          </p>
          <a class="ghost" href="/manifesto">Read the manifesto →</a>
        </div>
      </div>
      <div class="founders" data-reveal>
        <div class="spalte">
          <span class="eyebrow">Founders circle</span>
          <h2>A small group of prop traders starts here, and shapes what comes next.</h2>
          <p style="font-size:17px;line-height:1.65;color:var(--on-ink-muted);margin:0">
            FixedR is rolling out deliberately: a small group of prop traders first, then the
            waitlist, in order of signup.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <span class="feld">you@example.com</span>
          <a class="knopf" href="/waitlist">Join the waitlist</a>
          <span class="klein">Mail about your seat and the launch, occasionally about the guide and FixedR. One click unsubscribes.</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // ── Akt 02: welche Lage die Bühne zeigt ──────────────────────────────────
  // Der Entwurf bestimmt den aktiven Schritt per IntersectionObserver mit
  // `rootMargin: -40% 0 -50%` — ein schmales Band in der Bildschirmmitte. Nur was
  // DORT steht, gilt als aktiv; dadurch wechselt die Bühne, wenn der Schritt gelesen
  // wird, und nicht schon beim Hereinscrollen.
  const schritte = document.querySelectorAll<HTMLElement>('[data-schritt]');
  const lagen = document.querySelectorAll<HTMLElement>('[data-lage]');
  const punkte = document.querySelectorAll<HTMLElement>('[data-punkt]');
  const titel = document.querySelector<HTMLElement>('[data-buehne-titel]');
  const TITEL = ['One ticket · three accounts', 'Roles, not windows', 'Payout protection', 'Your month in R'];

  if (schritte.length && lagen.length) {
    const zeige = (n: number) => {
      schritte.forEach((el, i) => el.toggleAttribute('data-aktiv', i === n));
      // Eine schon gezeigte Lage weicht nach OBEN, eine kommende steht unten —
      // deshalb gibt es neben „an" auch „vor". Ohne das läge der Wechsel in beide
      // Richtungen gleich und die Bewegung verlöre ihre Richtung.
      lagen.forEach((el, i) => {
        el.toggleAttribute('data-an', i === n);
        el.toggleAttribute('data-vor', i < n);
      });
      punkte.forEach((el, i) => el.toggleAttribute('data-an', i === n));
      if (titel) titel.textContent = TITEL[n] ?? TITEL[0];
    };
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) zeige(Number((e.target as HTMLElement).dataset.schritt)); }),
      { rootMargin: '-40% 0px -50% 0px' },
    );
    schritte.forEach((el) => io.observe(el));
  }

  // ── Roter Faden: weicher Sprung zum Akt, 80 px Versatz für die Kopfleiste ──
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-faden]')) {
    a.addEventListener('click', (e) => {
      const ziel = document.querySelector<HTMLElement>(`[data-akt="${a.dataset.faden}"]`);
      if (!ziel) return;
      e.preventDefault();
      window.scrollTo({ top: ziel.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  }

  // ── Film-Schleier: Zeigerposition über der Bildkarte ──────────────────────
  // BEFUND FXR-164 (Michael 2026-09-06): Chrome rechnet `:hover` während des
  // Bildlaufs nicht neu — „beim reinscrollen passiert das nicht". Deshalb neben
  // `:hover` eine Klasse, die die Position bei Bewegung UND beim Scrollen prüft.
  const stage = document.querySelector<HTMLElement>('.home-hero .stage');
  if (stage) {
    let px = -1;
    let py = -1;
    const pruefe = () => {
      if (px < 0) return;
      const b = stage.getBoundingClientRect();
      stage.classList.toggle('is-hover', px >= b.left && px <= b.right && py >= b.top && py <= b.bottom);
    };
    window.addEventListener('mousemove', (e) => { px = e.clientX; py = e.clientY; pruefe(); }, { passive: true });
    window.addEventListener('scroll', pruefe, { passive: true });
    window.addEventListener('resize', pruefe, { passive: true });
    document.addEventListener('mouseleave', () => { px = -1; py = -1; stage.classList.remove('is-hover'); });
  }
</script>
