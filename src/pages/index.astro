---
// Startseite — Runde 13 (FXR-142): 1:1 nach `temp/export-web-v2/FixedR Web Home.html`
// (README, Abschnittsreihenfolge und Wortlaut sind die Vorgabe). Bild-Komponenten
// (Distribution/RCalendar) sind unveraendert aus FXR-26 uebernommen — ihre Daten
// decken sich bereits mit der Referenz. LayoutMosaic + die Kartenfuellungen 'One
// order' sind Korrektur FXR-142 (2026-09-03): 1:1 aus der Referenz gebaut.
import Base from '../layouts/Base.astro';
import Distribution from '../components/illus/Distribution.astro';
import LayoutMosaic from '../components/illus/LayoutMosaic.astro';
import RCalendar from '../components/illus/RCalendar.astro';

const pillars = [
  { nr: '01', title: 'The R view', text: 'Risk fixed before entry, results as multiples of it. Money never appears on screen.' },
  { nr: '02', title: 'Safety guard', text: "Your firm's rules — drawdown, daily loss, flatten time — enforced before the order leaves, on every account at once." },
  { nr: '03', title: 'Backtest', text: 'Replay any market at your pace, trade it as if live, and see the result in R before it costs anything.' },
  { nr: '04', title: 'Journal', text: 'Every trade documented on the way through: setup, rule compliance, outcome. Nothing to fill in afterwards.' },
];

// Keine Zahl, kein Währungszeichen (E-C009/`preisnennung`-Wächter: die Website nennt
// KEINE Preise, solange FXR-74 nicht entschieden ist — ausdrücklich Nicht-Ziel dieses
// Tickets). Die Referenz zeigt Beispielzahlen "als Vorschlag"; hier bleibt der Rahmen
// (Karten, Schnitt, Reihenfolge) exakt, der Betrag ist TBD statt eines Vorgriffs.
const packages = [
  { name: 'Basic', price: 'TBD', note: 'One account, the whole cockpit.', points: ['1 account', 'Mandatory stop, size from risk', 'R journal and calendar', 'Multi-timeframe workspaces'], featured: false, cta: 'Start with Basic' },
  { name: 'Advanced', price: 'TBD', note: 'Several accounts, one order ticket.', points: ['Up to 3 accounts', 'Distribute a trade across accounts', 'Payout protection', 'Multi-monitor layouts'], featured: true, cta: 'Join the waitlist' },
  { name: 'Pro', price: 'TBD', note: 'For the trader running a book.', points: ['Unlimited accounts', 'Backtest sessions with replay', 'Risk that follows a rule', 'Priority support'], featured: false, cta: 'Talk to us' },
];
---
<Base bare>
  <!-- Hero -->
  <section class="home-hero ink">
    <span class="big-r" aria-hidden="true">R</span>
    <div class="inner">
      <div class="intro">
        <span class="pill"><span class="dot"></span>For prop traders · Windows app · founders circle open</span>
        <h1>Loud charts. Calm numbers. <span class="accent">Trade in R.</span></h1>
        <p class="lede">
          Money changes scale with every account and pulls at you on every trade.
          <strong>R does neither.</strong> One unit from your first evaluation to the account
          that pays out.
        </p>
        <div class="actions">
          <a class="btn" href="/waitlist">Join the waitlist</a>
          <a class="btn ghost" href="/manifesto">Why no money?</a>
        </div>
        <p class="meta">
          Works with <strong>MetaTrader</strong> &amp; <strong>NinjaTrader</strong> ·
          runs on your machine · no cloud account
        </p>
      </div>
      <div class="stripe-wrap">
        <div class="stripe">
          <img src="/screens/trading-dark.png" alt="FixedR trading cockpit, dark mode" width="1600" height="1000" />
        </div>
      </div>
    </div>
  </section>

  <!-- Vier Säulen -->
  <section class="pillars">
    <div class="inner">
      {pillars.map((p) => (
        <a href="/product">
          <span class="nr"><span>{p.nr}</span><span class="ln"></span></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Die Regeln greifen vor dem Trade -->
  <section class="alt">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">The journal fills itself</p>
        <h2>The rules apply before the trade exists.</h2>
        <p>
          FixedR sits where the decision happens. It places the order, sizes it from your risk,
          and records the whole thing on the way through. The rules apply <em>before</em> the
          trade exists — there's no review afterwards where a rule could have quietly bent.
        </p>
      </div>
      <div class="grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="card">
          <div class="token">
            <span class="bars"><b></b><b></b><b></b></span>
            <span class="lbl">STOP · REQUIRED</span>
          </div>
          <h3>Mandatory stop-loss</h3>
          <p>No stop, no trade. Risk is fixed before entry — not renegotiated with yourself while the position runs.</p>
        </div>
        <div class="card">
          <div class="token">
            <span class="lbl">RISK</span><span class="val brand">1 R</span>
            <span class="arrow">→</span>
            <span class="lbl">SIZE</span><span class="val">4.2</span>
          </div>
          <h3>Position size from risk</h3>
          <p>You set the risk, FixedR computes the size from your stop distance. Backwards from the usual — and the only sane direction.</p>
        </div>
        <div class="card">
          <div class="token">
            <span class="val">+2.4 R</span>
            <span class="masked" aria-label="a currency amount, deliberately hidden">
              <span class="cur">$</span><i></i><i class="sep"></i><i></i><i></i><i></i>
            </span>
          </div>
          <h3>Money stays out of sight</h3>
          <p>Results, targets, drawdown headroom — all in R. No money mode, no toggle. The absence is the feature.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature-Bänder -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Built for funded accounts</p>
        <h2>One trade, every account, one set of rules.</h2>
      </div>

      <div class="feature-row">
        <div class="illu-box"><Distribution /></div>
        <div>
          <h2>Distribute a trade across accounts</h2>
          <p>
            Trading several funded accounts means executing the same idea several times, by hand,
            under time pressure. In FixedR you place it once and it goes out by your configuration.
          </p>
          <p>
            And a hard promise: <strong>without configuration, nothing is guessed.</strong> An
            unconfigured account stops the distribution with a loud error instead of quietly
            doing something almost right.
          </p>
        </div>
      </div>

      <div class="feature-row">
        <LayoutMosaic />
        <div>
          <h2>Timeframes that stay in sync</h2>
          <p>
            Put the same symbol on several timeframes side by side, and give each chart a
            role — <span class="r-value">HTF</span>, <span class="r-value">MTF</span>,
            <span class="r-value">LTF</span>. The synchronisation follows the role, not the
            window.
          </p>
          <p>
            That is the difference between an arrangement of windows and a named analysis
            structure: the charts belong together because you said what each one is for.
          </p>
        </div>
      </div>

      <div class="feature-row">
        <div class="illu-box"><RCalendar /></div>
        <div>
          <h2>Your month in R</h2>
          <p>
            Because R is defined by your own risk, the record stays comparable across accounts,
            account sizes and years. Scale from a 10k account to a 100k and the calendar reads
            exactly the same — that's the point.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ein Auftrag, jedes Konto -->
  <section class="alt">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">One order, every account</p>
        <h2>Your risk rules apply to you, across every account you trade.</h2>
        <p>
          Risk tools usually live inside a single platform, tied to a single login — each
          account enforcing its own rules alone, with no picture of you as a trader across all
          of them. FixedR connects your accounts at once, so the rules apply to the trader, not
          to whichever login happens to be open.
        </p>
      </div>
      <div class="grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="card">
          <span class="pill-tag">PAYOUT &middot; PAUSED</span>
          <h3>Protect the payout</h3>
          <p>
            Once an account is eligible for a payout, the money stops being hypothetical — and
            that's exactly when accounts get blown. FixedR can pause trading on that account
            until you've taken the money out. Every other risk tool protects you from a loss;
            this one protects a win.
          </p>
        </div>
        <div class="card">
          <div class="chips">
            <span class="on">FTMO</span><span class="on">Apex</span><span>TopStep</span>
          </div>
          <h3>Pick the accounts</h3>
          <p>
            Send a trade to all your accounts, or to the ones you choose. Different firms,
            different platforms, one order ticket — sized correctly for each account rather
            than copied blindly.
          </p>
        </div>
        <div class="card">
          <span class="risk-bars" aria-hidden="true">
            {[10,14,18,22,26,30,24,16,12].map((h, i) => (
              <span style={`height:${h}px${i === 5 ? ';background:var(--brand)' : ''}`}></span>
            ))}
          </span>
          <h3>Risk that follows a rule</h3>
          <p>
            One R doesn't have to be the same fraction forever. Let it follow the state of the
            account — smaller in drawdown, larger near target — written down as a rule in the
            account profile, not decided in the moment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pakete -->
  <section>
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Pricing</p>
        <h2>Three tiers. One set of rules.</h2>
        <span class="price-placeholder">SCHNITT UND PREISE — VORSCHLAG</span>
      </div>
      <div class="pricing-grid">
        {packages.map((p) => (
          <div class={`price-card ${p.featured ? 'hervor' : ''}`}>
            <span class="head">
              <span class="name">{p.name}</span>
              {p.featured && <span class="badge">MOST TRADERS</span>}
            </span>
            <span class="price">
              <span class="amount">{p.price}</span><span class="per">/ month</span>
            </span>
            <span class="satz">{p.note}</span>
            <a class="knopf" href="/waitlist">{p.cta}</a>
            <span class="points">
              {p.points.map((pt) => <span><span class="check">✓</span>{pt}</span>)}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- These: Tinte -->
  <section class="ink">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">What's on the screen</p>
        <h2>There's no money in this account. Only a number and a scale.</h2>
        <p>
          The balance of a funded account is notional — it isn't your money, and often not
          literal capital at all. What's real is your distance to the drawdown limit and to the
          target, both defined in percent. A currency display suggests a concreteness that
          doesn't exist. So we removed it.
        </p>
      </div>
      <p style="text-align: center; margin-top: 10px;"><a class="btn ghost" href="/manifesto">Read the manifesto</a></p>
    </div>
  </section>

  <!-- Founders circle -->
  <section class="alt">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Founders circle</p>
        <h2>A small group of prop traders starts here, and shapes what comes next.</h2>
        <p>
          FixedR is rolling out deliberately: a small group of prop traders first, then the
          waitlist, in order of signup.
        </p>
      </div>
      <p style="text-align: center; margin-top: 10px;"><a class="btn" href="/waitlist">Join the waitlist</a></p>
    </div>
  </section>
</Base>
