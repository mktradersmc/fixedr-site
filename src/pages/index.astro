---
// Startseite — Kanvas-Entwurf `temp/export-web-v6` (FXR-239, 2026-09-12).
//
// v6 macht aus der Abschnittsfolge einen ROTEN FADEN: Hero → vier Kacheln 01–04, die
// in den Hero ragen und weich zu ihrem Akt springen → Akt 01 (drei Regeln, Einleitung
// bleibt beim Scrollen stehen) → Akt 02 (vier Schritte links, EINE feste Bühne rechts,
// deren Lage mit dem Schritt wechselt) → Akt 03/04 → Pricing → These und Founders auf
// einer gemeinsamen dunklen Fläche.
//
// Entfallen gegenüber v5: Kennzahlenband, die drei Konto-Karten, „These" als eigener
// Abschnitt, die Founders-Karte mit App-Ausschnitt. Das ist Absicht, nicht Verlust.
//
// Gestalt in `styles/home.css` — Werte dort aus dem Export abgeschrieben.
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { FEATURE_PAGES, LINE_OF } from '../content/produktnavigation';
import '../styles/home.css';

// FXR-164: der Produktfilm existiert noch nicht. Ohne Datei bleibt es beim Standbild,
// ohne Konsolenfehler — die Einbindung ist vorbereitet (stumm, Schleife, Poster).
const heroVideoExists = existsSync(
  fileURLToPath(new URL('../../public/videos/product-loop.mp4', import.meta.url)),
);
const SCREEN = '/20261109_Lander_Screen.png';

// Der rote Faden. Jede Kachel springt zu `[data-akt]` — Text unverändert aus v5.
const saeulen = [
  { nr: '01', titel: 'The R view', text: 'Risk fixed before entry, results as multiples of it. Money never appears on screen.' },
  { nr: '02', titel: 'Safety guard', text: "Your firm's rules — drawdown, daily loss, flatten time — enforced before the order leaves, on every account at once." },
  { nr: '03', titel: 'Backtest', text: 'Replay any market at your pace, trade it as if live, and see the result in R before it costs anything.' },
  { nr: '04', titel: 'Journal', text: 'Every trade documented on the way through: setup, rule compliance, outcome. Nothing to fill in afterwards.' },
];

// FXR-1765: drei Zusagen vor den Preisen. Aussagen über die Bedingungen, nie über den Trader.
const zusagen = [
  { nr: '01', titel: 'No money on screen', text: 'Risk, result and distance to the limit appear only in R and percent. There is no toggle that brings a currency view back.', link: null },
  { nr: '02', titel: 'Your data stays on your machine', text: 'FixedR runs locally on Windows. Your trades, accounts and journal never reach us. You sign in with a FixedR account for the licence.', link: { href: '/trust', text: 'What does cross the line is on Trust →' } },
  { nr: '03', titel: 'You place every trade', text: 'No bot, no signals, no black box. FixedR enforces your own rules and records what happened; the decision stays with the trader.', link: null },
];

const buehneTitel =['One ticket · three accounts', 'Roles, not windows', 'Payout protection', 'Your month in R'];

const verteilung = [
  { konto: 'FTMO 100k', wert: '4.2', ok: true },
  { konto: 'Apex 150k', wert: '6.1', ok: true },
  { konto: 'Lucid 50k', wert: 'not configured', ok: false },
];

// Balken der Zeitrahmen-Lage: deterministisch aus dem Index, damit jeder Bau gleich
// aussieht und ein Bildvergleich überhaupt etwas wert ist.
const balken = (n: number, basis: number, faktor: number, spanne: number, markiert = false) =>
  Array.from({ length: n }, (_, j) => {
    const hoch = markiert && j % 3 === 0;
    return `flex:1;height:${basis + ((j * faktor) % spanne)}%;border-radius:2px;background:${hoch ? 'var(--brand-on-ink)' : 'var(--ink-line-2)'};opacity:${hoch ? 0.8 : 1}`;
  });
const balkenH = balken(14, 35, 37, 60, true);
const balkenM = balken(10, 30, 53, 65);
const balkenL = balken(10, 25, 29, 70);

const werte = [0, 1.2, -0.4, 2.1, 0, 0, 0, 0.8, 1.9, -1, 0.5, 3.2, 0, 0, -0.6, 2.4, 1.1, 0, 0.9, 1.4, 0, 0, -0.3, 1.8, 2.6, 0.7, -1.2, 0];
const monatDunkel = werte.map((w) => {
  const leer = w === 0;
  const stark = w >= 1.8;
  return {
    wert: leer ? '' : (w > 0 ? '+' : '−') + Math.abs(w).toFixed(1),
    stil: `display:grid;place-items:center;height:38px;border-radius:8px;font-family:var(--font-mono);font-size:11px;font-weight:500;background:${leer ? 'var(--ink-3)' : w > 0 ? (stark ? 'var(--brand-on-ink)' : 'rgba(46,134,246,.22)') : 'var(--ink-3)'};border:1px solid ${leer ? 'var(--ink-line)' : 'transparent'};color:${w > 0 ? (stark ? '#fff' : 'var(--brand-on-ink)') : 'var(--on-ink-muted)'}`,
  };
});

// Akt 03: Kerzen der Replay-Karte, ebenfalls deterministisch.
const kerzen = Array.from({ length: 26 }, (_, i) => {
  const y = 26 + Math.sin(i * 0.55) * 12 + i * 0.9 + (i % 3) * 4;
  const hh = 10 + ((i * 7) % 18);
  const auf = (i * 7) % 5 < 3;
  const c = auf ? 'var(--on-ink-muted)' : 'var(--ink-line-2)';
  return `position:absolute;left:${4 + i * 3.6}%;top:${y}%;width:1.9%;height:${hh}%;border-radius:1px;background:${c};box-shadow:0 -${hh * 0.25}px 0 0 ${c},0 ${hh * 0.2}px 0 0 ${c};opacity:${auf ? 0.85 : 1}`;
});

const plan = [['Setup', 'Pullback'], ['Entry', '17,830'], ['Stop', '17,812 · 1.0 R'], ['Target', '17,866 · 2.0 R']].map(([k, v]) => ({ k, v }));
const ergebnis = [
  ['Closed', '17,861', 'color:var(--on-ink)'],
  ['Result', '+1.7 R', 'color:var(--brand-on-ink);font-weight:600'],
  ['Stop moved', 'no', 'color:var(--on-ink)'],
  ['Rule check', 'held', 'color:var(--on-ink)'],
].map(([k, v, stil]) => ({ k, v, stil }));

// FXR-164 (Michael 2026-09-05, „Bitte Preise auch übernehmen"): €19/39/69 als
// Vorschlag; der Hinweis bleibt stehen, solange FXR-74 nicht entschieden ist.
const pakete = [
  { name: 'Basic', preis: '€19', satz: 'One account, the whole cockpit.', punkte: ['1 account', 'Mandatory stop, size from risk', 'R journal and calendar', 'Multi-timeframe workspaces'], hervor: false, cta: 'Start with Basic' },
  { name: 'Advanced', preis: '€39', satz: 'Several accounts, one order ticket.', punkte: ['Up to 3 accounts', 'Distribute a trade across accounts', 'Payout protection', 'Multi-monitor layouts'], hervor: true, cta: 'Join the waitlist' },
  { name: 'Pro', preis: '€69', satz: 'For the trader running a book.', punkte: ['Unlimited accounts', 'Backtest sessions with replay', 'Risk that follows a rule', 'Priority support'], hervor: false, cta: 'Talk to us' },
];
---
<Base bare>
  <!-- ═══ Hero ═══ -->
  <section class="home-hero">
    <span class="raster" aria-hidden="true"></span>
    <span class="big-r-wrap" aria-hidden="true"><span class="big-r">R</span></span>
    <div class="inner">
      <div class="intro">
        <p class="eyebrow">For prop traders · Windows · founders circle forming</p>
        <h1>Loud charts. Calm numbers. <span class="accent">Trade in R.</span></h1>
        <p class="lede">
          Money changes scale with every account and pulls at you on every trade.
          <strong>R does neither.</strong> One unit from your first evaluation to the account
          that pays out.
        </p>
        <span class="actions">
          <a class="btn" href="/waitlist">Join the waitlist</a>
          <a class="btn ghost" href="/manifesto">Why no money?</a>
        </span>
        <p class="meta">
          <span class="lbl">WORKS WITH</span>
          <span class="chip">MetaTrader</span>
          <span class="chip">NinjaTrader</span>
          <span class="rest">· runs on your machine · trading data stays local</span>
        </p>
      </div>
      {/* Michael 2026-09-11: die Karte nimmt ihre Höhe vom Bild, damit jeder Screenshot
          vollständig und randlos sitzt — kein festes Verhältnis, kein `scale` auf dem
          Inhalt. Das bewacht `tools/guards.mjs`. */}
      <div class="stage">
        <div class="stage-content">
          {heroVideoExists ? (
            <video class="stage-video" autoplay muted loop playsinline poster={SCREEN} aria-hidden="true">
              <source src="/videos/product-loop.mp4" type="video/mp4" />
            </video>
          ) : (
            <img src={SCREEN} alt="The FixedR cockpit: two synchronised M15 charts with sessions and pivot levels, dark mode" width="2880" height="1662" />
          )}
        </div>
        <div class="stage-veil">
          <span class="play-btn" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
          </span>
          <span class="stage-caption">
            <span class="stage-title">One trade, in R, start to finish.</span>
            {heroVideoExists && <span class="stage-sub">45 s · no sound needed</span>}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Roter Faden: 01–04, jede Kachel springt zu ihrem Akt ═══ -->
  <section class="faden">
    <div class="inner">
      {saeulen.map((p, i) => (
        <a href={`#akt-${i + 1}`} data-faden={i + 1}>
          <span class="nr"><span>{p.nr}</span><span class="ln"></span></span>
          <span class="t">{p.titel}</span>
          <span class="d">{p.text}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ 01 · The R view: drei Regeln, Einleitung bleibt stehen ═══ -->
  <section class="akt1" data-akt="1" id="akt-1">
    <div class="inner">
      <div class="lead" data-reveal>
        <span class="eyebrow">01 · The R view</span>
        <h2>The rules apply before the trade exists.</h2>
        <p>
          FixedR sits where the decision happens. It places the order, sizes it from your risk,
          and records the whole thing on the way through. The rules apply <em>before</em> the
          trade exists — there's no review afterwards where a rule could have quietly bent.
        </p>
      </div>
      <div class="regeln">
        <div class="regel" data-reveal>
          <span class="kreis">01</span>
          <span class="txt">
            <span class="t">Mandatory stop-loss</span>
            <span class="d">No stop, no trade. Risk is fixed before entry — not renegotiated with yourself while the position runs.</span>
            <span class="bild" style="align-items:center;gap:10px;font-size:12px;letter-spacing:.06em;color:var(--faint)">
              <span style="display:flex;align-items:center;gap:4px">
                <span style="width:3px;height:22px;background:var(--brand)"></span>
                <span style="width:3px;height:14px;background:var(--brand-line)"></span>
                <span style="width:3px;height:14px;background:var(--brand-line)"></span>
              </span>STOP · REQUIRED
            </span>
          </span>
        </div>
        <div class="regel" data-reveal>
          <span class="kreis">02</span>
          <span class="txt">
            <span class="t">Position size from risk</span>
            <span class="d">You set the risk, FixedR computes the size from your stop distance. Backwards from the usual — and the only sane direction.</span>
            <span class="bild" style="align-items:baseline;gap:12px">
              <span style="font-size:12px;letter-spacing:.06em;color:var(--faint)">RISK</span>
              <span style="font-size:22px;font-weight:600;color:var(--brand)">1 R</span>
              <span style="font-size:12px;color:var(--faint)">→</span>
              <span style="font-size:12px;letter-spacing:.06em;color:var(--faint)">SIZE</span>
              <span style="font-size:22px;font-weight:600">4.2</span>
            </span>
          </span>
        </div>
        <div class="regel" data-reveal>
          <span class="kreis">03</span>
          <span class="txt">
            <span class="t">Money stays out of sight</span>
            <span class="d">Results, targets, drawdown headroom — all in R. No money mode, no toggle. The absence is the feature.</span>
            {/* ⚠️ Der unscharfe Betrag IST hier das Argument: das R steht scharf, der
                Geldwert unlesbar daneben. Der Claim-Wächter `dollarbetrag` sperrt sonst
                jeden Geldbetrag; für genau diese eine Stelle gibt es eine eng
                geschnittene Ausnahme in `guards-rules.mjs`. Offener Punkt in FXR-239 —
                Michael entscheidet, ob die Ausnahme bleibt. */}
            <span class="bild" style="align-items:baseline;gap:12px">
              <span style="font-size:22px;font-weight:600">+2.4 R</span>
              <span class="verwischt" aria-hidden="true">$1,240</span>
            </span>
          </span>
        </div>
        <span class="schluss-linie"></span>
      </div>
    </div>
  </section>

  <!-- ═══ 02 · Safety guard: vier Schritte, eine feste Bühne ═══ -->
  <section class="akt2" data-akt="2" id="akt-2">
    <div class="kopf">
      <div class="txt" data-reveal>
        <span class="eyebrow">02 · Safety guard</span>
        <h2>One trade, every account, one set of rules.</h2>
        <p class="firmen">
          Rule profiles are maintained today for Apex, FTMO, IQ Capital and Lucid. In
          preparation: FundedNext, The5ers, MyFundedFutures, Blue Guardian, Alpha Capital Group
          and Sure Leverage Funding. Platforms: MetaTrader 5 and NinjaTrader 8.
        </p>
      </div>
    </div>
    <div class="inner">
      <div class="schritte">
        <div class="schritt" data-schritt="0" data-aktiv>
          <h3>Distribute a trade across accounts</h3>
          <p>Trading several funded accounts means executing the same idea several times, by hand, under time pressure. In FixedR you place it once and it goes out by your configuration.</p>
          <p>And a hard promise: <strong>without configuration, nothing is guessed.</strong> An unconfigured account stops the distribution with a loud error instead of quietly doing something almost right.</p>
        </div>
        <div class="schritt" data-schritt="1">
          <h3>Timeframes that stay in sync</h3>
          <p>
            Put the same symbol on several timeframes side by side, and give each chart a role —
            <span class="rolle">HTF</span>, <span class="rolle">MTF</span>, <span class="rolle">LTF</span>.
            The synchronisation follows the role, not the window.
          </p>
          <p>That is the difference between an arrangement of windows and a named analysis structure: the charts belong together because you said what each one is for.</p>
        </div>
        <div class="schritt" data-schritt="2">
          <h3>Protect the payout</h3>
          <p>Once an account is eligible for a payout, the money stops being hypothetical — and that's exactly when accounts get blown. FixedR can pause trading on that account until you've taken the money out. Every other risk tool protects you from a loss; this one protects a win.</p>
        </div>
        <div class="schritt" data-schritt="3">
          <h3>Your month in R</h3>
          <p>Because R is defined by your own risk, the record stays comparable across accounts, account sizes and years. Scale from a 10k account to a 100k and the calendar reads exactly the same — that's the point.</p>
        </div>
      </div>

      <div class="buehne-wrap">
        <div class="buehne-sticky">
          <div class="buehne">
            <span class="raster" aria-hidden="true"></span>
            <span class="titel" data-buehne-titel>{buehneTitel[0]}</span>
            <span class="fortschritt" aria-hidden="true">
              {[0, 1, 2, 3].map((i) => <span data-punkt={i} data-an={i === 0 ? '' : undefined}></span>)}
            </span>

            <div class="lage" data-lage="0" data-an>
              <div class="mono" style="width:440px;display:flex;flex-direction:column;gap:12px;font-size:13px">
                <span style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-radius:8px;background:var(--brand-on-ink);color:#fff"><span>MES · SHORT</span><span style="font-weight:600">1 R</span></span>
                <span style="display:flex;flex-direction:column;gap:8px;padding-left:22px;border-left:1px solid var(--ink-line-2)">
                  {verteilung.map((v) => (
                    <span style="display:flex;align-items:center;justify-content:space-between;padding:13px 18px;border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2);color:var(--on-ink-muted)">
                      <span style="color:var(--on-ink)">{v.konto}</span>
                      <span style={v.ok ? 'color:var(--brand-on-ink);font-weight:600' : 'color:#e0a34a;font-size:11px'}>{v.wert}</span>
                    </span>
                  ))}
                </span>
              </div>
            </div>

            <div class="lage" data-lage="1">
              <div style="width:480px;display:grid;grid-template-columns:2fr 1fr;grid-template-rows:repeat(2,150px);gap:10px">
                <span class="mono" style="grid-row:span 2;border-radius:8px;background:var(--ink-2);border:1px solid var(--brand-on-ink);display:flex;flex-direction:column;justify-content:space-between;padding:14px;font-size:12px;color:var(--brand-on-ink)">
                  <span>HTF · H4</span>
                  <span style="display:flex;align-items:flex-end;gap:4px;height:60%">{balkenH.map((b) => <span style={b}></span>)}</span>
                </span>
                <span class="mono" style="border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2);display:flex;flex-direction:column;justify-content:space-between;padding:14px;font-size:12px;color:var(--on-ink-muted)">
                  <span>MTF · M15</span>
                  <span style="display:flex;align-items:flex-end;gap:3px;height:50%">{balkenM.map((b) => <span style={b}></span>)}</span>
                </span>
                <span class="mono" style="border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2);display:flex;flex-direction:column;justify-content:space-between;padding:14px;font-size:12px;color:var(--on-ink-muted)">
                  <span>LTF · M1</span>
                  <span style="display:flex;align-items:flex-end;gap:3px;height:50%">{balkenL.map((b) => <span style={b}></span>)}</span>
                </span>
              </div>
            </div>

            <div class="lage" data-lage="2">
              <div class="mono" style="width:440px;display:flex;flex-direction:column;gap:12px;font-size:13px">
                <span style="display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2)">
                  <span style="display:flex;flex-direction:column;gap:4px">
                    <span style="color:var(--on-ink)">Apex 150k</span>
                    <span style="font-size:11px;color:var(--on-ink-faint)">Eligible since Tue · target reached</span>
                  </span>
                  <span style="padding:5px 10px;border-radius:5px;background:var(--ink-3);border:1px solid #e0a34a;color:#e0a34a;font-size:11px;letter-spacing:.08em">PAUSED</span>
                </span>
                <span style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                  <span style="padding:14px 16px;border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2);display:flex;flex-direction:column;gap:4px">
                    <span style="font-size:10px;letter-spacing:.1em;color:var(--on-ink-faint)">MONTH</span>
                    <span style="font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--brand-on-ink)">+8.2 R</span>
                  </span>
                  <span style="padding:14px 16px;border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2);display:flex;flex-direction:column;gap:4px">
                    <span style="font-size:10px;letter-spacing:.1em;color:var(--on-ink-faint)">TO LIMIT</span>
                    <span style="font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--on-ink)">4.1 R</span>
                  </span>
                </span>
                <span style="font-size:12px;color:var(--on-ink-faint);text-align:center;padding-top:4px;font-family:var(--font-text)">Resumes when the payout is confirmed out.</span>
              </div>
            </div>

            <div class="lage" data-lage="3">
              <div style="width:440px;display:flex;flex-direction:column;gap:14px;padding:22px;border-radius:8px;background:var(--ink-2);border:1px solid var(--ink-line-2)">
                <span style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px">
                  {monatDunkel.map((t) => <span style={t.stil}>{t.wert}</span>)}
                </span>
                <span style="display:flex;align-items:baseline;justify-content:space-between;padding-top:14px;border-top:1px solid var(--ink-line-2)">
                  <span class="mono" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--on-ink-faint)">May · all accounts</span>
                  <span style="font-family:var(--font-display);font-size:26px;font-weight:600;color:var(--brand-on-ink)">+11.4 R</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 03 · Backtest und 04 · Journal ═══ -->
  <section class="akt34" data-akt="3" id="akt-3">
    <div class="inner">
      <div class="spalte" data-reveal>
        <div class="bild">
          {kerzen.map((c) => <span style={c}></span>)}
          <span style="position:absolute;left:62%;top:0;bottom:44px;width:1px;background:var(--brand-on-ink);opacity:.8"></span>
          <span style="position:absolute;left:62%;right:0;top:0;bottom:44px;background:repeating-linear-gradient(135deg,transparent 0 6px,rgba(46,134,246,.07) 6px 7px)"></span>
          <span class="mono" style="position:absolute;left:calc(62% + 10px);top:14px;padding:3px 8px;border-radius:4px;background:var(--brand-on-ink);color:#fff;font-size:10px;font-weight:600;letter-spacing:.08em">FUTURE HIDDEN</span>
          <span class="mono" style="position:absolute;left:0;right:0;bottom:0;height:44px;display:flex;align-items:center;gap:8px;padding:0 14px;border-top:1px solid var(--ink-line);background:var(--ink-2);font-size:11px;color:var(--on-ink-muted)">
            <span style="width:26px;height:26px;display:grid;place-items:center;border-radius:6px;background:var(--brand-on-ink);color:#fff;font-size:11px">▶</span>
            <span>×4</span>
            <span style="margin-left:auto;color:var(--brand-on-ink);font-weight:600">+3.1 R</span>
          </span>
        </div>
        <span class="eyebrow">03 · Backtest</span>
        <h2>Trade the past at your own pace.</h2>
        <p>
          A backtest is only worth something if the trade goes in the way a real one does. So in
          FixedR it does — same order ticket, same mandatory stop, same size computed from your
          risk, same result in R.
        </p>
      </div>
      <div class="spalte" data-akt="4" id="akt-4" data-reveal>
        <div class="bild mono" style="display:grid;grid-template-columns:1fr 1fr;font-size:12px;color:var(--on-ink-muted)">
          <span style="padding:18px;border-right:1px solid var(--ink-line);display:flex;flex-direction:column;gap:10px">
            <span style="font-size:10px;letter-spacing:.1em;color:var(--on-ink-faint)">PLAN · AT ENTRY</span>
            {plan.map((z) => <span style="display:flex;justify-content:space-between;gap:8px"><span>{z.k}</span><span style="color:var(--on-ink)">{z.v}</span></span>)}
          </span>
          <span style="padding:18px;display:flex;flex-direction:column;gap:10px">
            <span style="font-size:10px;letter-spacing:.1em;color:var(--on-ink-faint)">OUTCOME · AT CLOSE</span>
            {ergebnis.map((z) => <span style="display:flex;justify-content:space-between;gap:8px"><span>{z.k}</span><span style={z.stil}>{z.v}</span></span>)}
          </span>
        </div>
        <span class="eyebrow">04 · Journal</span>
        <h2>The journal fills itself, because the order was set here first.</h2>
        <p>
          A journal that requires typing gets filled for a week and then stops. One that fills
          itself is still there in month three. The plan was the order ticket; the outcome is the
          trade as it closed.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ The whole cockpit: alle elf Produktseiten (FXR-1765) ═══ -->
  <section class="cockpit">
    <div class="inner">
      <div class="kopf" data-reveal>
        <span class="eyebrow">The whole cockpit</span>
        <h2>Eleven parts, one page each.</h2>
        <p>Each part of the cockpit has its own page: what it does, how it behaves and where its limits are.</p>
      </div>
      <div class="hub-tiles" data-reveal>
        {FEATURE_PAGES.map((p) => (
          <a class="hub-tile" href={`/product/${p.slug}`}>
            <span class="ic"><Icon name={p.icon} size={20} /></span>
            <span class="t">{p.title}</span>
            <span class="d">{LINE_OF[p.slug]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Drei Zusagen (FXR-1765) ═══ -->
  <section class="zusagen">
    <div class="inner">
      <div class="kopf" data-reveal>
        <span class="eyebrow">Three promises</span>
        <h2>What you can rely on, by how it is built.</h2>
      </div>
      <div class="karten" data-reveal>
        {zusagen.map((z) => (
          <div class="karte">
            <span class="nr">{z.nr}</span>
            <span class="t">{z.titel}</span>
            <span class="d">{z.text}</span>
            {z.link && <a href={z.link.href}>{z.link.text}</a>}
