---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base
  title="Blog"
  description="Essays on risk-first trading: R-denominated thinking, prop-firm psychology, and the discipline lessons trading can borrow from aviation."
  narrow
>
  <h1>Blog</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <span class="date">{post.data.date.toISOString().slice(0, 10)}</span>
        <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
