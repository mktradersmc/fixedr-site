---
// FXR-239 (Kanvas v7): neues Gerüst, KEIN geänderter Text.
import TextPage from '../../layouts/TextPage.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<TextPage
  title="Blog"
  description="Essays on risk-first trading: R-denominated thinking, prop-firm psychology, and the discipline lessons trading can borrow from aviation."
  eyebrow="Read"
  h1="Blog"
  seite="Blog"
  hinweis="Five posts. Written for prop traders, not for search engines."
  bare
>
  <div class="blog-raster">
    {posts.map((post, i) => (
      <a href={`/blog/${post.slug}`} class:list={[i === 0 && 'gross']}>
        <span class="datum">{post.data.date.toISOString().slice(0, 10)}</span>
        <span class="t">{post.data.title}</span>
        <span class="d">{post.data.description}</span>
        {/* Vorlage v7: der Lese-Hinweis sitzt am FUSS der Karte (`margin-top:auto`),
            damit er bei unterschiedlich langen Beschreibungen auf einer Linie steht. */}
        <span class="read" aria-hidden="true">Read →</span>
      </a>
    ))}
  </div>
</TextPage>
