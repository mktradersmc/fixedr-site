---
// Korrektur FXR-142 (Michael 2026-09-03): die Warteliste hatte noch die alte Ueberschrift
// und einen abweichenden Feldsatz (trades/firms statt Plattform-Wahl). Jetzt 1:1 nach
// `temp/export-web-v2/FixedR Web Waitlist.html` — Ueberschrift, Lede und die Plattform-
// Auswahl (MetaTrader/NinjaTrader/Both) aus der Referenz, echtes E-Mail-Feld. Ohne
// WAITLIST_ENDPOINT (E-C131 noch offen) oeffnet "Join the waitlist" den mailto-Fallback
// mit E-Mail und Plattform vorbelegt statt eines POSTs — ehrlich (kein Formular, das ins
// Leere sendet), aber optisch die Referenz. Review-Befund vom 03.09. (Danke-Seite darf
// keinen Mailversand behaupten, den der Bau nicht ausloest) gilt unveraendert weiter.
import Base from '../layouts/Base.astro';
import { WAITLIST_ENDPOINT, WAITLIST_EMAIL } from '../config';

const hasEndpoint = WAITLIST_ENDPOINT.length > 0;
---
<Base
  title="Waitlist"
  description="Join the FixedR waitlist. The founders circle is filled first, in order of signup."
  bare
>
  <section class="waitlist-hero ink">
    <div class="inner">
      <div class="intro">
        <p class="eyebrow">Founders circle</p>
        <h1>A small group of prop traders starts here, and shapes what comes next.</h1>
        <p class="lede">
          FixedR is rolling out deliberately: a small group of prop traders first, then the
          waitlist, in order of signup.
        </p>
      </div>

      <div class="waitlist-card">
        <form
          class="waitlist waitlist-v2"
          id="waitlist-form"
          action={hasEndpoint ? WAITLIST_ENDPOINT : undefined}
          method={hasEndpoint ? 'POST' : undefined}
          data-mailto-fallback={hasEndpoint ? undefined : 'true'}
          data-mailto-email={WAITLIST_EMAIL}
        >
          {/* FXR-45: Redirect nach dem Absenden zur Danke-Seite (nur mit echtem Endpoint —
              `_next` ist die Formspree-Konvention, Feldname dienst-abhaengig, FXR-44). */}
          {hasEndpoint && <input type="hidden" name="_next" value="/thanks" />}
          <label for="email">Email
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
          <label>Platform
            <span class="platform-pills" role="radiogroup" aria-label="Platform">
              <label class="pf-pill">
                <input type="radio" name="platform" value="MetaTrader" checked />
                <span>MetaTrader</span>
              </label>
              <label class="pf-pill">
                <input type="radio" name="platform" value="NinjaTrader" />
                <span>NinjaTrader</span>
              </label>
              <label class="pf-pill">
                <input type="radio" name="platform" value="Both" />
                <span>Both</span>
              </label>
            </span>
          </label>
          <button class="btn" type="submit">Join the waitlist</button>
        </form>
        <p class="fine">No newsletter. One mail when your seat opens.</p>
        {!hasEndpoint && (
          <p class="fine">Already sent it? <a href="/thanks">Continue to your guide</a>.</p>
        )}
        <p class="fine">
          Your address goes on the waitlist, nothing else — details in the
          <a href="/privacy">privacy policy</a>.
        </p>
      </div>
    </div>
  </section>

  {!hasEndpoint && (
    <script>
      // Kein WAITLIST_ENDPOINT (E-C131): das Formular sendet nichts an einen Server, es
      // oeffnet stattdessen den Mail-Client mit E-Mail + gewaehlter Plattform vorbelegt —
      // dieselbe ehrliche Loesung wie zuvor am mailto-Knopf, jetzt am reference-genauen
      // Formular. Kein Redirect zur Danke-Seite (mailto: loest keine Navigation aus).
      const form = document.getElementById('waitlist-form');
      if (form && form.hasAttribute('data-mailto-fallback')) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = document.getElementById('email').value.trim();
          const platform = form.querySelector('input[name="platform"]:checked')?.value ?? '';
          const to = form.getAttribute('data-mailto-email');
          const body =
            'Hi,\n\nplease put me on the FixedR waitlist.\n\n' +
            `Email: ${email}\nPlatform: ${platform}\n`;
          const href =
            `mailto:${to}?subject=${encodeURIComponent('FixedR waitlist')}&body=${encodeURIComponent(body)}`;
          window.location.href = href;
        });
      }
    </script>
  )}

</Base>
