---
// /features → /product (product\10 §10 Frage 2: jetzt umleiten oder nie — die Site ist
// noch nicht veröffentlicht, der alte Pfad ist trotzdem kostenlos zu erhalten).
// Über die Base-Layout-Seite statt astro.config `redirects`, damit noindex/canonical aus
// Base.astro garantiert mitkommen (der dist-Wächter verlangt noindex auf JEDER Seite).
import Base from '../layouts/Base.astro';
---
<Base title="Product" description="This page moved to /product.">
  <meta http-equiv="refresh" content="0; url=/product" slot="head" />
  <p>
    This page moved. Continuing to <a href="/product">/product</a>…
  </p>
</Base>
